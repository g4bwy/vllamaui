+/**
+ * Response from GET /vllm/stats, served by the vLLM adapter only.
+ * A plain llama.cpp server has no such route, so the block never renders there.
+ * Rate values are absent until the adapter has collected a full window, and the
+ * engine details are strings because the upstream reports them that way.
+ */
+export interface ApiVllmStats {
+	sampled_at?: string;
+	gauges?: {
+		requests_running?: number;
+		requests_waiting?: number;
+		kv_cache_usage_percent?: number;
+		prefix_cache_hit_percent?: number;
+		spec_decode_accept_percent?: number;
+		tokens_per_step?: number;
+		preemptions?: number;
+	};
+	rates?: {
+		window_s?: number;
+		generation_tokens_per_second?: number;
+		prompt_tokens_per_second?: number;
+		steps_per_second?: number;
+		window_accept_percent?: number;
+	};
+	counters?: {
+		prompt_tokens?: number;
+		generation_tokens?: number;
+		requests?: number;
+		avg_ttft_ms?: number;
+		avg_inter_token_ms?: number;
+		avg_queue_ms?: number;
+		avg_prefill_ms?: number;
+		avg_decode_ms?: number;
+		avg_prefill_tokens?: number;
+	};
+	engine?: {
+		model?: string;
+		block_size?: string;
+		num_gpu_blocks?: string;
+		kv_cache_size_tokens?: string;
+		prefix_caching?: string;
+		gpu_memory_utilization?: string;
+	};
+}
