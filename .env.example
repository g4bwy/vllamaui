# Copy to .env and edit. .env is gitignored, so your host and key never
# reach the repo. Anything set in the real environment wins over this file.

# vLLM base URL
VLLM_UPSTREAM=http://localhost:8000

# Where the UI listens
PORT=8080
HOST=0.0.0.0

# Optional: model id to send when the UI omits it, and a bearer token if your
# vLLM needs one
# VLLM_MODEL=your-model-id
# VLLM_API_KEY=

# See README.md for VLLM_MODALITY_VISION, VLLM_ENGINE_TIMINGS and friends
