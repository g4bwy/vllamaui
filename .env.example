# Copy to .env and edit. .env is gitignored, so your host and key never
# reach the repo. Anything set in the real environment wins over this file.

# Backend: vllm, strata, or auto (auto asks the server what it is)
BACKEND=auto

# Backend base URL. VLLM_UPSTREAM is the older name for the same thing.
UPSTREAM_URL=http://localhost:8000

# Where the UI listens
PORT=8080
HOST=0.0.0.0

# Optional: bearer token, if your backend requires one.
# VLLM_API_KEY is the older name for this one too.
# UPSTREAM_API_KEY=secret

# Optional: model id to send when the UI leaves it out
# VLLM_MODEL=your-model-id

# README.md covers VLLM_MODALITY_VISION, VLLM_ENGINE_TIMINGS, the two
# probe switches, and UI_DIST
